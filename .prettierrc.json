{
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindFunctions": ["clsx","tw"],
  "tailwindConfig": "./tailwind.config.js",
  "tailwindAttributes": ["tw"],
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": true,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "quoteProps": "consistent",
  "bracketSpacing": true,
  "singleAttributePerLine": true
}